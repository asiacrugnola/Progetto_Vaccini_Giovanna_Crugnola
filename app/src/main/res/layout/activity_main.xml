<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Titolo dell'App -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Valutazione Vaccini in Terapia Biologica"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- Campo per l'Età -->
    <EditText
        android:id="@+id/etEta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Inserisci l'età del paziente"
        android:inputType="number"
        android:layout_marginBottom="16dp"/>

    <!-- Campo per la Terapia Biologica -->
    <EditText
        android:id="@+id/etTerapia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Terapia biologica (es. anti-TNF)"
        android:inputType="text"
        android:layout_marginBottom="24dp"/>

    <!-- Bottone per il calcolo -->
    <Button
        android:id="@+id/btnCalcola"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calcola Raccomandazioni"/>

</LinearLayout>