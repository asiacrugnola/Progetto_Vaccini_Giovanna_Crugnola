<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/activity_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Titolo dell'App -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginBottom="32dp"
            android:background="#E3F2FD"
            android:fontFamily="sans-serif-condensed-medium"
            android:gravity="center"
            android:textStyle="bold|italic"
            android:padding="16dp"
            android:text="My Vaccines"
            android:textColor="#0D47A1"
            android:textSize="25sp" />

        <!-- Campo per l'Età -->
        <EditText
            android:id="@+id/etEta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:hint="Inserisci l'età del paziente"
            android:inputType="number" />

        <!-- Tendina selezione multipla: Terapia Biologica -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Terapia biologica"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvTerapie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginBottom="20dp"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:background="@android:drawable/edit_text"
            android:hint="Seleziona terapia biologica..." />

        <!-- Tendina selezione multipla: Condizioni Cliniche -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Condizioni cliniche"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCondizioni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginBottom="24dp"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:background="@android:drawable/edit_text"
            android:hint="Seleziona condizioni cliniche..." />

        <!-- Bottone per il calcolo -->
        <Button
            android:id="@+id/btnCalcola"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Calcola Raccomandazioni" />

    </LinearLayout>
</ScrollView>